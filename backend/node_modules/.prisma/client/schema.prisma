// ------------------------------------------------------
// Prisma Schema
// CreditMiners
// Database: Supabase PostgreSQL
// ORM: Prisma
// ------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum MediaType {
  IMAGE
  DOCUMENT
}

enum InterestStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum DocumentType {
  ID_PROOF
  ADDRESS_PROOF
  BANK_STATEMENT
  SALARY_SLIP
  BUSINESS_PROOF
  COLLATERAL_PROOF
  OTHER
}

enum EmploymentType {
  STUDENT
  EMPLOYED
  SELF_EMPLOYED
  FREELANCER
  BUSINESS_OWNER
  UNEMPLOYED
  RETIRED
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum EducationLevel {
  HIGH_SCHOOL
  DIPLOMA
  BACHELORS
  MASTERS
  DOCTORATE
  OTHER
  PREFER_NOT_TO_SAY
}

enum IncomeFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
  IRREGULAR
}

enum SavingsHabit {
  NONE
  OCCASIONAL
  REGULAR
  AUTOMATED
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  INVESTMENT
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  NET_BANKING
  BANK_TRANSFER
  WALLET
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum InvestmentType {
  SIP
  MUTUAL_FUND
  ETF
  STOCK
  FIXED_DEPOSIT
  GOLD
}

enum RecommendationPriority {
  LOW
  MEDIUM
  HIGH
}

enum LoanVisibility {
  PUBLIC
  PRIVATE
}

enum FundingStatus {
  OPEN
  PARTIALLY_FUNDED
  FULLY_FUNDED
  EXPIRED
}

enum RecommendationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssessmentType {
  INITIAL
  MONTHLY
  ON_DEMAND
  SIMULATION
}

enum AuditAction {
  REGISTER
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  PROFILE_UPDATE
  TRANSACTION_CREATE
  TRANSACTION_UPDATE
  TRANSACTION_DELETE
  ASSESSMENT_GENERATED
  RECOMMENDATION_VIEWED
  GOAL_CREATED
  GOAL_UPDATED
}

enum LoanStatus {
  DRAFT
  PUBLISHED
  FUNDED
  CLOSED
  CANCELLED
}

enum LoanCategory {
  PERSONAL
  EDUCATION
  BUSINESS
  MEDICAL
  AGRICULTURE
  HOME
  VEHICLE
  EMERGENCY
  OTHER
}

enum LoanPurpose {
  PERSONAL
  EDUCATION
  BUSINESS
  MEDICAL
  AGRICULTURE
  HOME_RENOVATION
  VEHICLE
  DEBT_CONSOLIDATION
  EMERGENCY
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CollateralType {
  NONE
  PROPERTY
  VEHICLE
  GOLD
  BUSINESS
  MACHINERY
  INVENTORY
  OTHER
}

enum FinancialSource {
  MANUAL
  CSV
  ACCOUNT_AGGREGATOR
  BANK_STATEMENT
  UTILITY_PROVIDER
  RECHARGE_PROVIDER
  ECOMMERCE_PLATFORM
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum UtilityType {
  ELECTRICITY
  WATER
  GAS
  INTERNET
  MOBILE_POSTPAID
  OTHER
}

enum BillStatus {
  PAID
  PARTIAL
  MISSED
  PENDING
}

enum RechargeStatus {
  SUCCESS
  FAILED
  PENDING
}

enum RechargeProvider {
  AIRTEL
  JIO
  VI
  BSNL
  OTHER
}

enum OrderStatus {
  DELIVERED
  RETURNED
  CANCELLED
  REFUNDED
  PENDING
  SHIPPED
}

enum ConsentScope {
  ALL
  ACCOUNT_AGGREGATOR
  UTILITY_BILL
  MOBILE_RECHARGE
  ECOMMERCE
  BANK_STATEMENT
}

// ------------------------------------------------------
// ROLE
// ------------------------------------------------------

model Role {
  id String @id @default(uuid()) @db.Uuid

  name String @unique

  description String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  users User[]

  @@map("roles")
}

model LoanMedia {
  id String @id @default(uuid()) @db.Uuid

  loanId String @db.Uuid

  loan LoanRequest @relation(fields: [loanId], references: [id], onDelete: Cascade)

  mediaType      MediaType
  collateralType CollateralType @default(NONE)

  collateralValue Decimal? @db.Decimal(18, 2)

  collateralDescription String? @db.Text

  documentType DocumentType?

  fileName String

  fileUrl String

  publicId String?

  isCover Boolean @default(false)

  displayOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([loanId])
  @@map("loan_media")
}

// ------------------------------------------------------
// USER
// ------------------------------------------------------

model User {
  // Primary Key

  id String @id @default(uuid()) @db.Uuid

  // Personal Information

  fullName String

  email String @unique

  phone String? @unique

  profileImage String?

  dateOfBirth DateTime?

  gender Gender?

  education EducationLevel?

  city String?

  state String?

  country String?

  // Authentication

  passwordHash String

  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  failedLoginAttempts Int @default(0)

  lockUntil DateTime?

  emailVerified       Boolean   @default(false)
  verificationToken   String?   @unique
  verificationExpires DateTime?

  pendingEmail       String?   @unique
  emailChangeToken   String?   @unique
  emailChangeExpires DateTime?

  phoneVerified            Boolean   @default(false)
  pendingPhone             String?   @unique
  phoneVerificationToken   String?   @unique
  phoneVerificationExpires DateTime?

  auditLogs AuditLog[]

  // Account Status

  isVerified Boolean @default(false)

  isActive Boolean @default(true)

  status UserStatus @default(ACTIVE)

  // Soft Delete

  deletedAt DateTime?

  // Role

  roleId String @db.Uuid

  role Role @relation(fields: [roleId], references: [id])

  // Relations

  financialProfile FinancialProfile?

  preferences UserPreference?

  onboarding Onboarding?

  financialSnapshots FinancialSnapshot[]

  transactions Transaction[]

  financialGoals FinancialGoal[]

  creditAssessments CreditAssessment[]

  financialRecommendations FinancialRecommendation[]

  investmentRecommendations InvestmentRecommendation[]

  notifications Notification[]

  refreshTokens RefreshToken[]

  loanRequests  LoanRequest[]
  loanInterests LoanInterest[]

  utilityBills     UtilityBill[]
  mobileRecharges  MobileRecharge[]
  ecommerceOrders  EcommerceOrder[]
  userConsents     UserConsent[]
  financialImports FinancialImport[]

  // Timestamps

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phone])
  @@index([roleId])
  @@index([isActive])
  @@index([status])
  @@index([city])
  @@map("users")
}

model LoanInterest {
  id String @id @default(uuid()) @db.Uuid

  loanId     String @db.Uuid
  investorId String @db.Uuid

  amountOffered Decimal? @db.Decimal(18, 2)

  message String? @db.Text

  status InterestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loan LoanRequest @relation(fields: [loanId], references: [id], onDelete: Cascade)

  investor User @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@unique([loanId, investorId])
  @@index([loanId])
  @@index([investorId])
  @@map("loan_interests")
}

model LoanRequest {
  id String @id @default(uuid()) @db.Uuid

  borrowerId String @db.Uuid
  borrower   User   @relation(fields: [borrowerId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text

  amount Decimal @db.Decimal(18, 2)

  durationMonths Int

  media LoanMedia[]

  interests LoanInterest[]

  purpose LoanPurpose

  category LoanCategory

  status LoanStatus @default(DRAFT)

  // AI Assessment
  aiCreditScore Int?

  aiRecommendation  String?   @db.Text
  aiSummary         String?   @db.Text
  aiConfidence      Float?
  aiLastEvaluatedAt DateTime?

  // Existing Risk
  riskLevel RiskLevel?

  // Financial
  interestRate      Decimal?  @db.Decimal(5, 2)
  minimumInvestment Decimal?  @db.Decimal(12, 2)
  fundingDeadline   DateTime?
  expiryDate        DateTime?

  // Location
  country String?
  state   String?
  city    String?

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  // Analytics
  viewCount     Int   @default(0)
  bookmarkCount Int   @default(0)
  shareCount    Int   @default(0)
  trendingScore Float @default(0)

  // Metadata
  slug String? @unique

  visibility LoanVisibility @default(PUBLIC)

  fundingStatus FundingStatus @default(OPEN)

  lastActivityAt DateTime?

  verificationStatus VerificationStatus @default(PENDING)

  fundingProgress Decimal @default(0) @db.Decimal(5, 2)

  requiredFundingDate DateTime?

  publishedAt DateTime?

  closedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([borrowerId])
  @@index([status])
  @@index([category])
  @@index([riskLevel])
  @@index([createdAt])
  @@index([status, category])
  @@index([city])
  @@index([state])
  @@index([country])
  @@index([interestRate])
  @@index([fundingStatus])
  @@index([publishedAt])
  @@index([viewCount])
  @@index([trendingScore])
  @@index([latitude, longitude])
  @@map("loan_requests")
}

// ------------------------------------------------------
// REFRESH TOKEN
// ------------------------------------------------------

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  tokenHash String @unique

  expiresAt DateTime

  revoked Boolean @default(false)

  deviceInfo String?

  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ------------------------------------------------------
// FINANCIAL PROFILE
// ------------------------------------------------------

model FinancialProfile {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Personal Financial Information

  occupation String?

  employmentType EmploymentType

  annualIncome Decimal? @db.Decimal(18, 2)

  monthlyIncome Decimal? @db.Decimal(18, 2)

  incomeFrequency IncomeFrequency?

  monthlyExpenses Decimal? @db.Decimal(18, 2)

  savingsHabit SavingsHabit?

  existingInvestments Decimal @default(0) @db.Decimal(18, 2)

  emergencyFund Decimal @default(0) @db.Decimal(18, 2)

  riskLevel RiskLevel @default(MEDIUM)

  investmentExperience Int? // Years

  dependents Int @default(0)

  existingLiabilities Decimal @default(0) @db.Decimal(18, 2)

  preferredCurrency String @default("INR")

  notes String?

  // Relations

  snapshots FinancialSnapshot[]

  // Timestamps

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([employmentType])
  @@index([riskLevel])
  @@map("financial_profiles")
}

// ------------------------------------------------------
// USER PREFERENCES
// ------------------------------------------------------

model UserPreference {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  language String @default("en")

  theme Theme @default(SYSTEM)

  notificationPreferences Json?

  privacyPreferences Json?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

// ------------------------------------------------------
// ONBOARDING
// ------------------------------------------------------

model Onboarding {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentStep Int @default(1)

  profileCompletionPercentage Int @default(0)

  financialProfileCompletionPercentage Int @default(0)

  onboardingCompleted Boolean @default(false)

  completedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([onboardingCompleted])
  @@map("onboarding")
}

// ------------------------------------------------------
// FINANCIAL SNAPSHOT
// Historical Financial State
// ------------------------------------------------------

model FinancialSnapshot {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  profileId String           @db.Uuid
  profile   FinancialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Financial Inputs

  monthlyIncome Decimal @db.Decimal(18, 2)

  monthlyExpenses Decimal @db.Decimal(18, 2)

  monthlySavings Decimal @db.Decimal(18, 2)

  emergencyFund Decimal @default(0) @db.Decimal(18, 2)

  investmentCapacity Decimal @default(0) @db.Decimal(18, 2)

  currentInvestments Decimal @default(0) @db.Decimal(18, 2)

  liabilities Decimal @default(0) @db.Decimal(18, 2)

  netWorth Decimal? @db.Decimal(18, 2)

  // AI Features

  savingsRatio Decimal? @db.Decimal(6, 2)

  expenseRatio Decimal? @db.Decimal(6, 2)

  investmentRatio Decimal? @db.Decimal(6, 2)

  debtIncomeRatio Decimal? @db.Decimal(6, 2)

  cashFlow Decimal? @db.Decimal(18, 2)

  financialStabilityIndex Decimal? @db.Decimal(6, 2)

  // Relations

  assessments CreditAssessment[]

  // Dates

  snapshotDate DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([profileId])
  @@index([snapshotDate])
  @@index([userId, snapshotDate])
  @@map("financial_snapshots")
}

// ------------------------------------------------------
// TRANSACTION CATEGORY
// ------------------------------------------------------

model TransactionCategory {
  id String @id @default(uuid()) @db.Uuid

  name String @unique

  description String?

  icon String?

  color String?

  transactionType TransactionType

  isSystem Boolean @default(true)

  transactions Transaction[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([transactionType])
  @@map("transaction_categories")
}

// ------------------------------------------------------
// TRANSACTION
// ------------------------------------------------------

model Transaction {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String              @db.Uuid
  category   TransactionCategory @relation(fields: [categoryId], references: [id])

  amount Decimal @db.Decimal(18, 2)

  transactionType TransactionType

  paymentMethod PaymentMethod

  merchant String?

  description String?

  location String?

  referenceNumber String?

  transactionDate DateTime

  isRecurring Boolean @default(false)

  receiptUrl String?

  tags String?

  importId String?          @db.Uuid
  import   FinancialImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  merchantId  String?   @db.Uuid
  merchantRef Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  categoryRefId String?   @db.Uuid
  categoryRef   Category? @relation(fields: [categoryRefId], references: [id], onDelete: SetNull)

  transactionTags TransactionTag[]

  utilityBill    UtilityBill?
  mobileRecharge MobileRecharge?
  ecommerceOrder EcommerceOrder?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([categoryId])
  @@index([importId])
  @@index([merchantId])
  @@index([categoryRefId])
  @@index([transactionDate])
  @@index([userId, transactionDate])
  @@index([transactionType])
  @@index([paymentMethod])
  @@map("transactions")
}

// ------------------------------------------------------
// FINANCIAL GOAL
// ------------------------------------------------------

model FinancialGoal {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String

  description String?

  targetAmount Decimal @db.Decimal(18, 2)

  currentAmount Decimal @default(0) @db.Decimal(18, 2)

  targetDate DateTime?

  priority RecommendationPriority @default(MEDIUM)

  status GoalStatus @default(ACTIVE)

  progressPercentage Decimal? @db.Decimal(5, 2)

  isArchived Boolean @default(false)

  completedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([targetDate])
  @@map("financial_goals")
}

// ------------------------------------------------------
// AI MODEL VERSION
// ------------------------------------------------------

model AIModelVersion {
  id String @id @default(uuid()) @db.Uuid

  name String

  version String @unique

  description String?

  algorithm String?

  isActive Boolean @default(true)

  trainedAt DateTime?

  deployedAt DateTime?

  createdAt DateTime @default(now())

  // Relations

  assessments CreditAssessment[]

  @@index([isActive])
  @@map("ai_model_versions")
}

// ------------------------------------------------------
// CREDIT ASSESSMENT
// ------------------------------------------------------

model CreditAssessment {
  id String @id @default(uuid()) @db.Uuid

  // Relations

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  snapshotId String            @db.Uuid
  snapshot   FinancialSnapshot @relation(fields: [snapshotId], references: [id])

  modelVersionId String         @db.Uuid
  modelVersion   AIModelVersion @relation(fields: [modelVersionId], references: [id])

  // AI Results

  financialHealthScore Decimal @db.Decimal(5, 2)

  estimatedCreditScore Int

  confidenceScore Decimal @db.Decimal(5, 2)

  riskLevel RiskLevel

  assessmentType AssessmentType @default(INITIAL)

  explainabilityScore Decimal? @db.Decimal(5, 2)

  summary String? @db.Text

  modelParameters Json?

  generatedAt DateTime @default(now())

  createdAt DateTime @default(now())

  // Child Relations

  factors AssessmentFactor[]

  recommendations FinancialRecommendation[]

  investmentRecommendations InvestmentRecommendation[]

  @@index([userId])
  @@index([snapshotId])
  @@index([modelVersionId])
  @@index([generatedAt])
  @@index([userId, generatedAt])
  @@map("credit_assessments")
}

// ------------------------------------------------------
// ASSESSMENT FACTORS
// ------------------------------------------------------

model AssessmentFactor {
  id String @id @default(uuid()) @db.Uuid

  assessmentId String @db.Uuid

  assessment CreditAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  factorName String

  featureValue String?

  description String?

  impactScore Decimal @db.Decimal(6, 2)

  importancePercentage Decimal @db.Decimal(5, 2)

  isPositive Boolean

  displayOrder Int

  createdAt DateTime @default(now())

  @@index([assessmentId])
  @@index([displayOrder])
  @@map("assessment_factors")
}

// ------------------------------------------------------
// FINANCIAL RECOMMENDATION
// ------------------------------------------------------

model FinancialRecommendation {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assessmentId String           @db.Uuid
  assessment   CreditAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  title String

  description String

  category String?

  priority RecommendationPriority

  status RecommendationStatus @default(PENDING)

  estimatedImpact String?

  dueDate DateTime?

  completedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([assessmentId])
  @@index([priority])
  @@index([status])
  @@index([userId, status])
  @@map("financial_recommendations")
}

// ------------------------------------------------------
// INVESTMENT RECOMMENDATION
// ------------------------------------------------------

model InvestmentRecommendation {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assessmentId String           @db.Uuid
  assessment   CreditAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  investmentType InvestmentType

  recommendationTitle String

  recommendationText String

  suggestedAmount Decimal? @db.Decimal(18, 2)

  expectedReturn Decimal? @db.Decimal(5, 2)

  investmentDuration Int? // Months

  riskLevel RiskLevel

  expectedRisk String?

  confidenceScore Decimal? @db.Decimal(5, 2)

  status RecommendationStatus @default(PENDING)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([assessmentId])
  @@index([investmentType])
  @@index([riskLevel])
  @@map("investment_recommendations")
}

// ------------------------------------------------------
// NOTIFICATION
// ------------------------------------------------------

model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String

  message String

  type NotificationType

  severity Severity @default(LOW)

  status NotificationStatus @default(UNREAD)

  actionUrl String?

  metadata Json?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([userId, status])
  @@map("notifications")
}

// ------------------------------------------------------
// AUDIT LOG
// ------------------------------------------------------

model AuditLog {
  id String @id @default(uuid())

  action String

  description String?

  ipAddress String?

  userAgent String?

  userId String? @db.Uuid

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// ------------------------------------------------------
// FINANCIAL IMPORT
// Batch Provenance & Audit Trail
// ------------------------------------------------------

model FinancialImport {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  source FinancialSource

  fileName String?
  fileSize Int?

  recordCount Int @default(0)

  status ImportStatus @default(PENDING)

  errorMessage String? @db.Text

  metadata Json?

  importedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions    Transaction[]
  utilityBills    UtilityBill[]
  mobileRecharges MobileRecharge[]
  ecommerceOrders EcommerceOrder[]

  @@index([userId])
  @@index([status])
  @@index([source])
  @@map("financial_imports")
}

// ------------------------------------------------------
// USER CONSENT
// Consent & Privacy Management
// ------------------------------------------------------

model UserConsent {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scope ConsentScope

  isGranted Boolean @default(true)

  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  expiresAt DateTime?

  ipAddress String?
  userAgent String?

  consentVersion String @default("1.0")

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([scope])
  @@index([userId, scope])
  @@map("user_consents")
}

// ------------------------------------------------------
// MERCHANT
// Normalized Vendor & Merchant Entities
// ------------------------------------------------------

model Merchant {
  id String @id @default(uuid()) @db.Uuid

  name String  @unique
  code String? @unique

  category String?
  logoUrl  String?
  website  String?

  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions    Transaction[]
  ecommerceOrders EcommerceOrder[]

  @@index([name])
  @@map("merchants")
}

// ------------------------------------------------------
// CATEGORY
// Normalized Taxonomy Entity
// ------------------------------------------------------

model Category {
  id String @id @default(uuid()) @db.Uuid

  name String  @unique
  slug String? @unique

  description String?
  icon        String?
  color       String?

  parentId String?   @db.Uuid
  parent   Category? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)

  subcategories Category[] @relation("CategoryHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions    Transaction[]
  ecommerceOrders EcommerceOrder[]

  @@index([name])
  @@map("categories")
}

// ------------------------------------------------------
// TAG & TRANSACTION TAG
// Universal Tagging Engine
// ------------------------------------------------------

model Tag {
  id String @id @default(uuid()) @db.Uuid

  name  String  @unique
  color String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactionTags TransactionTag[]

  @@index([name])
  @@map("tags")
}

model TransactionTag {
  id String @id @default(uuid()) @db.Uuid

  transactionId String      @db.Uuid
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  tagId String @db.Uuid
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([transactionId, tagId])
  @@index([transactionId])
  @@index([tagId])
  @@map("transaction_tags")
}

// ------------------------------------------------------
// UTILITY BILL
// Alternative Signal Facts (Electricity, Water, Gas, etc)
// ------------------------------------------------------

model UtilityBill {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  importId String?          @db.Uuid
  import   FinancialImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  transactionId String?      @unique @db.Uuid
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  utilityType UtilityType

  providerName String

  accountNumber String?
  billNumber    String?

  billMonth String // Format: "YYYY-MM"

  billDate DateTime?
  dueDate  DateTime
  paidDate DateTime?

  amountDue  Decimal @db.Decimal(18, 2)
  amountPaid Decimal @default(0) @db.Decimal(18, 2)

  status BillStatus @default(PENDING)

  paymentDelayDays Int?

  receiptUrl String?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([utilityType])
  @@index([status])
  @@index([dueDate])
  @@index([userId, billMonth])
  @@map("utility_bills")
}

// ------------------------------------------------------
// MOBILE RECHARGE
// Alternative Signal Facts (Mobile Prepaid History)
// ------------------------------------------------------

model MobileRecharge {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  importId String?          @db.Uuid
  import   FinancialImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  transactionId String?      @unique @db.Uuid
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  provider RechargeProvider

  mobileNumber String?

  amount Decimal @db.Decimal(18, 2)

  rechargeDate DateTime

  validityDays Int?

  status RechargeStatus @default(SUCCESS)

  isEmergencyRecharge Boolean @default(false)

  planType String?

  referenceNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([provider])
  @@index([status])
  @@index([rechargeDate])
  @@index([userId, rechargeDate])
  @@map("mobile_recharges")
}

// ------------------------------------------------------
// E-COMMERCE ORDER
// Alternative Signal Facts (Online Purchasing Behaviour)
// ------------------------------------------------------

model EcommerceOrder {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  importId String?          @db.Uuid
  import   FinancialImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  transactionId String?      @unique @db.Uuid
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  merchantId String?   @db.Uuid
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  categoryId String?   @db.Uuid
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  platform String

  orderId String?

  orderDate DateTime

  amount Decimal @db.Decimal(18, 2)

  status OrderStatus @default(DELIVERED)

  isReturned Boolean @default(false)
  isRefunded Boolean @default(false)

  paymentMode PaymentMethod

  itemCount Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([platform])
  @@index([status])
  @@index([orderDate])
  @@index([userId, orderDate])
  @@map("ecommerce_orders")
}
